# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (Settings > API) ----------
# Sem estas 3 variáveis o app roda em MODO DEMONSTRAÇÃO (dados locais em .demo/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- fal.ai (https://fal.ai/dashboard/keys) ----------
# Sem a chave, os vídeos são simulados (zoom na foto via ffmpeg)
FAL_KEY=

# ---------- Pix ----------
# Provedor principal: woovi ou efi (se o principal falhar, tenta o outro)
PAYMENT_PROVIDER=woovi

# Woovi / OpenPix (Painel > API/Plugins > AppID)
WOOVI_APP_ID=
WOOVI_SANDBOX=false

# Efí Bank (API Pix: client id/secret + certificado .p12 em base64)
#   base64 -w0 certificado.p12  -> cole em EFI_CERT_BASE64
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_BASE64=
EFI_CERT_PASSWORD=
EFI_PIX_KEY=
EFI_SANDBOX=false

# Segredo para rotas administrativas (ex.: cadastrar webhook da Efí)
WEBHOOK_SECRET=troque-este-valor

# ---------- Economia dos créditos ----------
# créditos = custo_IA_USD × USD_TO_BRL × CREDIT_MARKUP ÷ CREDIT_VALUE_BRL
USD_TO_BRL=5.6
CREDIT_MARKUP=1.5
CREDIT_VALUE_BRL=1
# (mesmos valores para o navegador mostrar o preço antes de gerar)
NEXT_PUBLIC_USD_TO_BRL=5.6
NEXT_PUBLIC_CREDIT_MARKUP=1.5
NEXT_PUBLIC_CREDIT_VALUE_BRL=1
